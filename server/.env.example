# =============================================================================
# Blood Bank Management System — SERVER environment template
# =============================================================================
# HOW TO USE
#   1. Copy this file:   cp .env.example .env
#   2. Fill REAL values in .env (never in this template).
#   3. .env must stay OUT of git. If it is tracked, run:
#        git rm --cached server/.env && git commit -m "stop tracking server/.env"
#
# LEGEND
#   [DEV]  = value to use on a developer machine
#   [PROD] = value to use on the production server / Docker
#   Lines starting with "#" are COMMENTED OUT (inactive). Activate the line
#   that matches your environment and comment the others.
# =============================================================================


# -----------------------------------------------------------------------------
# DATABASE — MongoDB
# -----------------------------------------------------------------------------
# Pick ONE. Keep the other two commented.
#
# [DEV]  Local MongoDB, no auth:
# MONGODB_URI=mongodb://localhost:27017/
#
# [DEV]  MongoDB Atlas (shared cloud dev cluster):
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/
#
# [PROD] Authenticated remote MongoDB (URL-encode special chars in password:
#        @ -> %40, # -> %23, : -> %3A):
MONGODB_URI=mongodb://<user>:<encoded-password>@<host>:27017/?authSource=admin
# Database name is forced to "BloodBank" in src/core/db regardless of URI path.


# -----------------------------------------------------------------------------
# REDIS — cache, rate limiting, Bull queues, Socket.IO adapter
# -----------------------------------------------------------------------------
# [DEV]  Local Redis on the host:
REDIS_URL=redis://localhost:6379
#
# [PROD] Inside Docker Compose, Redis is reachable by its SERVICE NAME, not
#        localhost. Use this line on the production server / in docker-compose:
# REDIS_URL=redis://redis:6379
# NOTE: REDIS_URL is required (see src/core/config/env.ts). The server will
#       refuse to boot without it — there is no localhost fallback.


# -----------------------------------------------------------------------------
# RUNTIME
# -----------------------------------------------------------------------------
PORT=5000
# [DEV] development   [PROD] production
NODE_ENV=development
# pino log level: fatal|error|warn|info|debug|trace
LOG_LEVEL=info


# -----------------------------------------------------------------------------
# CORS — allowed browser origin
# -----------------------------------------------------------------------------
# [DEV]  CORS_SERVER=http://localhost:5173
# [PROD] CORS_SERVER=https://system.sanjivanibloodbank.org
# Comma-separated. Merged with the STATIC_ORIGINS list in
# src/core/config/cors.ts, which already covers the known prod domains.
CORS_SERVER=http://localhost:5173


# -----------------------------------------------------------------------------
# JWT / AUTH
# -----------------------------------------------------------------------------
# [PROD] Generate strong random secrets (>=32 chars). Do NOT reuse the dev ones.
#        openssl rand -base64 48
JWT_SECRET=<random-secret-1>
JWT_SECRET_KEY=<random-secret-2>
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d


# -----------------------------------------------------------------------------
# EMAIL — Gmail SMTP (nodemailer). Use a Gmail App Password, NOT the account
#         password. Requires 2FA enabled on the Gmail account.
# -----------------------------------------------------------------------------
EMAIL_USER=<sender@gmail.com>
EMAIL_PASS=<gmail-app-password>
EMAIL_FROM_NAME=Sanjivani Blood Bank
EMAIL_HOST=smtp.gmail.com
# Port 465 + secure true  (SSL)  -> recommended, used in current prod
# Port 587 + secure false (STARTTLS)
EMAIL_PORT=465
EMAIL_SECURE=true
ADMIN_EMAIL=<admin@example.com>


# -----------------------------------------------------------------------------
# BLOOD BANK IDENTITY — printed on PDF reports and in email footers.
# Defaults in src/core/config/env.ts are placeholders; set these in every
# environment or reports go out with the wrong licence number.
# -----------------------------------------------------------------------------
BANK_NAME=Sanjivani Blood Bank
BANK_ADDRESS=<street, city, state - pincode>
BANK_PHONE=<+91-XXX-XXXXXXX>
BANK_LICENSE=<drug licence / blood bank licence no.>
BANK_WEBSITE=https://sanjivanibloodbank.org


# -----------------------------------------------------------------------------
# FILE STORAGE — S3-compatible object store (MinIO in prod).
# Used by modules/upload. Leaving these blank makes every upload fail at
# runtime; the server still boots.
# -----------------------------------------------------------------------------
S3_ENDPOINT=<https://s3.example.com>
S3_REGION=us-east-1
S3_ACCESS_KEY=<access-key>
S3_SECRET_KEY=<secret-key>
S3_BUCKET=blood-bank
S3_PUBLIC_URL=<https://s3.example.com/blood-bank>


# -----------------------------------------------------------------------------
# REPORTS / EXPIRY
# -----------------------------------------------------------------------------
REPORTS_DIR=./reports
# Near-expiry window in days. Component-specific thresholds also apply in code.
NEAR_EXPIRY_DAYS=2


# -----------------------------------------------------------------------------
# MISC
# -----------------------------------------------------------------------------
# Mongo ObjectId used as the actor for system-generated audit entries.
SYSTEM_USER_ID=<mongo-objectid>


# -----------------------------------------------------------------------------
# NOT USED — do not re-add without wiring a consumer first.
#   AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY / AWS_REGION / SNS_PHONE
#   TWILIO_ACCOUNT_SID / TWILIO_AUTH_TOKEN / TWILIO_PHONE_NUMBER
#   TIMEZONE  — the client formats in Asia/Kolkata (client/src/lib/format-date.js)
# -----------------------------------------------------------------------------
